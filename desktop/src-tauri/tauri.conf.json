{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MetrajAI",
  "version": "1.3.3",
  "identifier": "com.metrajai.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MetrajAI",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eef0ed"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/metrajai-engine"],
    "resources": ["resources/report-runtime/**/*", "resources/metrajai-ocr"],
    "category": "Productivity",
    "shortDescription": "Mühendis kontrollü, yerel metraj uygulaması",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
