{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MetrajAI main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/metrajai-engine",
          "sidecar": true,
          "args": [
            "serve",
            "--host",
            "127.0.0.1",
            "--port",
            "0",
            "--token",
            { "validator": "^[0-9a-f-]{36}$" }
          ]
        }
      ]
    },
    "shell:allow-kill"
  ]
}
